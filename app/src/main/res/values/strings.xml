    <string name="help_title">Help</string>
    <string name="help_summary">Write a message, choose Visual or Morse, then send. Visual shows the message on screen; Morse sends code with screen flashes, the flashlight, optional beeps, or any combination you choose.</string>
    <string name="help_visual_title">Visual mode</string>
    <string name="help_visual_body">Use transitions for screen text. Slide direction controls LTR/RTL movement; Slide vertical stacks letters by word.</string>
    <string name="help_morse_title">Morse mode</string>
    <string name="help_morse_body">Use Morse output to choose Screen, Torch, or Both. Morse beep plays the selected frequency during each mark. The current character is shown in the lower-right corner while it is being sent. International is the standard alphabet; Continental adds the extra letters shown below.</string>
    <string name="help_continental_note">Same as International, plus:</string>

